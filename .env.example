# File: .env.example
# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME=TISAXAI
ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://tisaxai:tisaxai@postgres:5432/tisaxai

JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CHROMA_HOST=chromadb
CHROMA_PORT=8000
DEFAULT_KB_COLLECTION_NAME=tisax_kb_final

EMBEDDING_MODEL_NAME=sentence-transformers/LaBSE

LLM_PROVIDER=anthropic
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2000

CORS_ORIGINS=["http://localhost:5173"]

EVIDENCE_STORAGE_PATH=./data/evidence
MAX_UPLOAD_SIZE_MB=25
